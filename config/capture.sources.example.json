{
  "raw_root": "data/raw",
  "market_prefixes": [
    "btc-updown-5m"
  ],
  "market_channels": [
    "book",
    "last_trade_price"
  ],
  "max_markets_per_prefix": 1,
  "debug_raw_market_ws": false,
  "market_ws": {
    "enabled": true,
    "url": "wss://ws-subscriptions-clob.polymarket.com/ws/market",
    "default_channel": "book",
    "reconnect_sec": 3,
    "subscribe": []
  },
  "user_ws": {
    "enabled": false,
    "url": "wss://ws-subscriptions-clob.polymarket.com/ws/user",
    "default_channel": "order",
    "reconnect_sec": 3,
    "subscribe": []
  },
  "meta_poll": {
    "enabled": true,
    "interval_sec": 20,
    "active_only": true,
    "conditional_get": true,
    "round_switch_delay_sec": 8
  },
  "settlement_poll": {
    "enabled": true,
    "interval_sec": 20,
    "per_condition_cooldown_sec": 30,
    "retention_hours": 12
  },
  "xuan_poll": {
    "enabled": false,
    "user": "",
    "interval_sec": 300,
    "aggressive_interval_sec": 60,
    "aggressive_trade_threshold": 500,
    "page_limit": 500,
    "max_pages": 30,
    "cursor_path": ""
  }
}
